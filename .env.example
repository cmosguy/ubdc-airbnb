# # This env file is loaded automatically by the services defined in docker-compose.yml
# # The priority is:
# #   1. Compose file
# #   2. Shell environment variables
# #   3. Environment file
# #   4. Dockerfile
# #   5. Variable is not defined
# ###############################################################################

# ============================================================================
# PROXY CONFIGURATION
# ============================================================================
# Choose your proxy provider: 'zyte' or 'oxylabs'
# PROXY_PROVIDER=oxylabs

# --- Zyte Configuration (use if PROXY_PROVIDER=zyte) ---
# ZYTE_API_KEY=your-zyte-api-key-here

# --- Oxylabs Configuration (use if PROXY_PROVIDER=oxylabs) ---
# OXYLABS_USERNAME=your-oxylabs-username
# OXYLABS_PASSWORD=your-oxylabs-password

# ============================================================================
# AIRBNB API CONFIGURATION
# ============================================================================
# AIRBNB_LISTINGS_MOVED_MIN_DISTANCE="150"
# AIRBNB_PUBLIC_API_KEY="d306zoyjsyarp7ifhu67rjxn52tv0t20"

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# CELERY_DEFAULT_RATE_LIMIT="10/m"
# CELERY_WORKER_PREFETCH_MULTIPLIER=1
# DEFAULT_HOURS_BEFORE_LISTING_CALENDAR_IS_STALE=23
# DEFAULT_HOURS_BEFORE_LISTING_DETAILS_IS_STALE=23
# DEFAULT_HOURS_BEFORE_LISTING_REVIEW_IS_STALE=23
# DEFAULT_HOURS_BEFORE_SCAN_FOR_NEW_LISTINGS=10
# DJANGO_ENV=DEV

# ============================================================================
# DATABASE CONFIGURATION
